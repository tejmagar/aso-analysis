# Optional. Leave unset for a local loopback server: no auth is the right
# default on a laptop. Set it before exposing the port anywhere.
#   ASO_API_TOKEN=$(openssl rand -hex 24)
ASO_API_TOKEN=

# Only if the bind address is genuinely private, e.g. a container network that
# nothing outside can reach. Lets the server start on 0.0.0.0 with no token.
# ASO_ALLOW_INSECURE=1

# Where the CLI and the bot look for the API.
# ASO_SERVER=http://127.0.0.1:8765
